.env
.env.*
!.env.example

# One-time local inputs for Vault bootstrap. Keep the directory itself so
# Compose can mount it after the secret file has been deleted.
secrets/*
!secrets/.gitkeep

frontend/.env.local
frontend/node_modules/
frontend/.next/

.venv
__pycache__/
*.py[cod]

# TLS material
infra/nginx/certs/*.crt
infra/nginx/certs/*.key
