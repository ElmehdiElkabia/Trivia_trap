  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "trivia-trap",
    "monitoring"
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/grafana/d/trivia-trap-overview",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/grafana/d/trivia-postgres",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false
