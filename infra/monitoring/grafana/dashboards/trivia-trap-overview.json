    {
      "id": 18,
      "title": "Nginx unhandled connections",
      "description": "Accepted minus handled connections per second. Usually zero. This is not an HTTP error count.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "clamp_min(sum(rate(nginx_connections_accepted{job=\"nginx\"}[$__rate_interval])) - sum(rate(nginx_connections_handled{job=\"nginx\"}[$__rate_interval])), 0)",
          "legendFormat": "Unhandled / sec",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
