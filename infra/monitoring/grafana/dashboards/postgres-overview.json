{
  "uid": "trivia-postgres",
  "title": "Trivia Trap - PostgreSQL",
  "description": "Connections, transactions, cache activity, and database pressure using the existing PostgreSQL exporter. Select one or more databases above.",
  "version": 2,
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "trivia-trap",
    "monitoring",
    "postgresql"
  ],
  "templating": {
    "list": [
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(pg_stat_database_numbackends{job=\"postgres\",datname!~\"template0|template1\",datname!=\"\"}, datname)",
        "query": {
          "query": "label_values(pg_stat_database_numbackends{job=\"postgres\",datname!~\"template0|template1\",datname!=\"\"}, datname)",
          "refId": "database"
        },
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/grafana/d/trivia-trap-overview",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "PostgreSQL",
      "type": "link",
      "url": "/grafana/d/trivia-postgres",
      "icon": "dashboard",
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Database at a glance",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "PostgreSQL",
      "description": "Database connectivity reported by the exporter; independent of the database filter.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "pg_up{job=\"postgres\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto",
        "orientation": "horizontal",
        "wideLayout": true
      }
    },
