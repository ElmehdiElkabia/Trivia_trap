    {
      "id": 5,
      "title": "Cache hits",
      "description": "Share of block reads served by PostgreSQL shared buffers. No activity when there are no reads; the OS cache is not included.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=~\"$database\",datname!~\"template0|template1\",datname!=\"\"}[$__rate_interval])) / (sum(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=~\"$database\",datname!~\"template0|template1\",datname!=\"\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{job=\"postgres\",datname=~\"$database\",datname!~\"template0|template1\",datname!=\"\"}[$__rate_interval])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No activity",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
